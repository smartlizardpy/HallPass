# Copy to .env.local for local dev, and set the same values in Vercel project
# settings for production. See the "Environment variables" table in README.md.

# ── PostHog: client-side capture (browser → PostHog) ────────────────────────
# REQUIRED for ANY analytics data to appear. NEXT_PUBLIC_ vars are inlined at
# BUILD time, so this must be set in Vercel *before* `next build` runs. When it
# is missing, posthog.init() no-ops and nothing is captured — not even
# autocapture / pageviews / pageleaves. Find it in PostHog → Project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here

# ── PostHog: server-side read (admin dashboard play-count queries) ──────────
# Optional; only needed for the /dashboard analytics panels. Separate from the
# client capture token above.
POSTHOG_API_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# ── Vercel Blob (game bundle storage) ───────────────────────────────────────
# Auto-provisioned by Vercel when a Blob store is linked.
BLOB_READ_WRITE_TOKEN=

# Emergency lock. Set to 1 to force EVERY advanced-blob feature off (publishing,
# media, beta evidence, cover caching, shot promotion, reindex) without needing
# the database — for when the monthly advanced-operation allowance is spent and
# migration 026 has not been applied. Beats the Dashboard -> Blob ops switches.
# Anything unrecognised, including 0 and false, leaves those switches in charge.
BLOB_READ_ONLY=

# ── Admin ───────────────────────────────────────────────────────────────────
# Gates /admin/html uploads.
ADMIN_HTML_PASSWORD=

# Gates POST|GET /api/v1/admin/boards (leaderboard provisioning), and salts
# scores.ip_hash when SCOREBOARD_IP_SALT is unset. Falls back to
# ADMIN_HTML_PASSWORD.
SCOREBOARD_ADMIN_SECRET=

# ── Site alerts (traffic spikes, error spikes, missing games) ───────────────
# Gates the two alert endpoints, and is what the half-hourly GitHub Actions cron
# holds as a repository secret (Settings → Secrets and variables → Actions).
# Generate one with:  openssl rand -hex 32
#
# Falls back to SCOREBOARD_ADMIN_SECRET, then ADMIN_HTML_PASSWORD, so the
# feature works with what you already have. Setting it REPLACES those rather
# than joining them, so rotating it actually revokes the old credential — which
# matters, because this is the one secret that lives in a repository's settings
# where anyone who can edit a workflow file can read it.
#
# Unset everywhere: both endpoints answer 503 and nothing is ever alerted.
# Reading the analytics also needs POSTHOG_PERSONAL_API_KEY above.
ALERTS_SECRET=

# ── Bug MCP (agent access to the playtest bug queue) ────────────────────────
# Gates POST /api/mcp, the MCP server a coding agent connects to in order to
# read and resolve beta_reports. Generate one with:  openssl rand -hex 32
#
# DELIBERATELY HAS NO FALLBACK, unlike ALERTS_SECRET above. This surface deletes
# reports and pays testers XP, so it must not switch itself on because an
# unrelated admin password happens to be set. Unset: /api/mcp answers 503 and
# refuses everybody. It is also independently rotatable — nothing else
# authenticates with it, so changing it revokes the agent and nothing more.
MCP_SECRET=

# OPTIONAL. What the MCP records in beta_reports.resolved_by and
# beta_xp_awards.awarded_by. Defaults to mcp@hallpass.invalid — an RFC 2606
# reserved domain, so a machine's decision in the XP ledger can never be
# mistaken for an admin's. Set it to distinguish several agents.
MCP_ACTOR=

# ── Web Push (challenge notifications) ──────────────────────────────────────
# OPTIONAL. With these unset the whole notification path reports itself
# unavailable and stays silent — challenges still work, they are just pulled
# when somebody visits rather than pushed. Nothing 500s without them.
#
# Deliberately NOT NEXT_PUBLIC_, even though the public key is not a secret:
# NEXT_PUBLIC_ vars are inlined at BUILD time (see the PostHog note above, and
# scripts/check-build-env.mjs, which exists because of exactly that trap). The
# public key is served at request time from GET /api/v1/me/push instead, so
# adding it here takes effect on the next request rather than the next build.
#
# Generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: the push service can use to contact you about a misbehaving sender.
# Required by the VAPID spec.
VAPID_SUBJECT=mailto:smartlizardpy@duck.com

# ── Analytics MCP (sign in with your HallPass account) ──────────────────────
# OPTIONAL, and OFF by default. With MCP_OAUTH_ENABLED unset, /api/mcp is
# reachable only with MCP_SECRET above and the OAuth endpoints answer 503.
#
# Turning it on lets a dashboard account sign in from an MCP client through a
# browser and read the arcade's analytics. Deliberately not inferred from Google
# sign-in already working: this surface reads the whole player base of a
# children's site, so switching it on should be something somebody decided.
MCP_OAUTH_ENABLED=

# The read-only Postgres role `run_analytics_sql` queries through. Create it and
# get this value with:
#
#   node scripts/provision-mcp-reader.mjs --yes
#
# That script also PROVES the boundary: it reconnects as the new role and fails
# loudly if `public.players` turns out to be readable.
#
# Without this the analytics tools still work and run_analytics_sql is simply
# not offered. It NEVER falls back to DATABASE_URL — a fail-open here would hand
# a language model every player's email address.
MCP_ANALYTICS_DATABASE_URL=

# Optional. EXTRA browser origins allowed to call /api/mcp cross-origin,
# comma-separated. Claude, ChatGPT and Gemini's own origins are allowed by
# default, and a non-browser caller sends no Origin at all, so most deployments
# need nothing here.
MCP_CORS_ORIGINS=
