# Copy to .env.local for local dev, and set the same values in Vercel project
# settings for production. See the "Environment variables" table in README.md.

# ── PostHog: client-side capture (browser → PostHog) ────────────────────────
# REQUIRED for ANY analytics data to appear. NEXT_PUBLIC_ vars are inlined at
# BUILD time, so this must be set in Vercel *before* `next build` runs. When it
# is missing, posthog.init() no-ops and nothing is captured — not even
# autocapture / pageviews / pageleaves. Find it in PostHog → Project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here

# ── PostHog: server-side read (admin dashboard play-count queries) ──────────
# Optional; only needed for the /dashboard analytics panels. Separate from the
# client capture token above.
POSTHOG_API_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# ── Vercel Blob (game bundle storage) ───────────────────────────────────────
# Auto-provisioned by Vercel when a Blob store is linked.
BLOB_READ_WRITE_TOKEN=

# ── Admin ───────────────────────────────────────────────────────────────────
# Gates /admin/html uploads.
ADMIN_HTML_PASSWORD=

# ── Web Push (challenge notifications) ──────────────────────────────────────
# OPTIONAL. With these unset the whole notification path reports itself
# unavailable and stays silent — challenges still work, they are just pulled
# when somebody visits rather than pushed. Nothing 500s without them.
#
# Deliberately NOT NEXT_PUBLIC_, even though the public key is not a secret:
# NEXT_PUBLIC_ vars are inlined at BUILD time (see the PostHog note above, and
# scripts/check-build-env.mjs, which exists because of exactly that trap). The
# public key is served at request time from GET /api/v1/me/push instead, so
# adding it here takes effect on the next request rather than the next build.
#
# Generate a pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: the push service can use to contact you about a misbehaving sender.
# Required by the VAPID spec.
VAPID_SUBJECT=mailto:smartlizardpy@duck.com
